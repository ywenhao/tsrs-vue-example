{
  "name": "tsrs-vue-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "preview": "bun --bun vite preview",
    "typecheck": "tsrs --runExternalCode --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --runExternalCode --noEmit --fast -p tsconfig.json",
    "typecheck:tsc": "tsc --runExternalCode --noEmit -p tsconfig.json",
    "typecheck:watch": "tsrs --runExternalCode --noEmit --watch -p tsconfig.json",
    "typecheck:errors": "tsrs --runExternalCode --noEmit --pretty false -p tsconfig.errors.json",
    "test": "bun scripts/verify-type-errors.mjs",
    "generate:bench": "bun scripts/generate-benchmark.mjs",
    "check:bench": "bun scripts/generate-benchmark.mjs --check",
    "bench": "bun scripts/benchmark.mjs",
    "bench:quick": "bun scripts/benchmark.mjs --runs 1 --warmup 0",
    "bench:setup": "bun install --cwd benchmark/toolchains/vue-tsc --frozen-lockfile",
    "bench:report": "bun scripts/benchmark-suite.mjs",
    "bench:report:quick": "bun scripts/benchmark-suite.mjs --runs 1 --warmup 0",
    "bench:render": "uv run --no-build --python 3.14 --script scripts/render-benchmark-report.py",
    "build": "bun run typecheck && bun --bun vite build"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/content-mapper": "4.0.0-alpha.2",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "7.1.0-beta",
    "vite": "8.3.5"
  }
}
